{
  "name": "simple-shop",
  "version": "1.0.0",
  "private": true,
  "description": "A stationery storefront with payment-slip checkout and an optional gRPC Study Kit Checker.",
  "scripts": {
    "format": "prettier --write \"backend/{src,scripts,tests}/**/*.js\" \"frontend/src/**/*.{js,jsx,css}\" \"frontend/*.js\" \"tests/**/*.js\" \"plugins/study-kit/{src,tests}/**/*.js\" \"plugins/study-kit/*.js\"",
    "format:check": "prettier --check \"backend/{src,scripts,tests}/**/*.js\" \"frontend/src/**/*.{js,jsx,css}\" \"frontend/*.js\" \"tests/**/*.js\" \"plugins/study-kit/{src,tests}/**/*.js\" \"plugins/study-kit/*.js\"",
    "lint": "npm --prefix backend run lint && npm --prefix frontend run lint && npm --prefix plugins/study-kit run lint",
    "test": "docker compose -f compose.test.yaml up --build --abort-on-container-exit --exit-code-from tests",
    "test:e2e": "npm --prefix frontend run test:e2e",
    "test:plugin": "npm --prefix plugins/study-kit test",
    "test:scripts": "node --test tests/scripts.test.js"
  },
  "devDependencies": {
    "prettier": "^3.9.8"
  },
  "type": "module"
}
