APP_PORT=8080
APP_ORIGIN=http://localhost:8080
NODE_ENV=production
SESSION_SECRET=GENERATE_WITH_SETUP_SCRIPT
COOKIE_SECURE=false
MONGO_IMAGE=mongo:7.0.43
MONGO_INITDB_ROOT_USERNAME=shop_root
MONGO_INITDB_ROOT_PASSWORD=GENERATE_WITH_SETUP_SCRIPT
MONGO_APP_USERNAME=shop_app
MONGO_APP_PASSWORD=GENERATE_WITH_SETUP_SCRIPT
MONGO_DB_NAME=simple_shop
MONGO_HOST=mongodb
MONGO_PORT=27017
UPLOAD_DIR=/app/storage/slips
MAX_SLIP_BYTES=5242880
STORE_CURRENCY=THB
PAYMENT_DEMO_MODE=true
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
SEED_DEMO_DATA=true
DEMO_CUSTOMER_PASSWORD=GENERATE_WITH_SETUP_SCRIPT
AUTH_RATE_LIMIT=20
ORDER_RATE_LIMIT=10
API_RATE_LIMIT=120
